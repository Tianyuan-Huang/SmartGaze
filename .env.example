# Local application and HTTPS model adapter
PORT=18475
ADAPTER_PORT=18476
DEMO_STORE=.runtime/accounts.json
DEMO_TLS_KEY=.runtime/tls/server.key
DEMO_TLS_CERT=.runtime/tls/server.crt
NODE_EXTRA_CA_CERTS=.runtime/tls/server.crt
JOYAI_DEMO_ENDPOINT=https://localhost:18476/push
JOYAI_DEMO_INTERACTION_ENDPOINT=https://localhost:18476/interact
# Filled with a random value by pnpm run setup
JOYAI_DEMO_KEY=
# Local vLLM model API
MODEL_API_BASE=http://127.0.0.1:8000/v1
MODEL_NAME=JoyAI-VL-Interaction-Preview
MODEL_API_KEY=
# Optional: Beijing-region DashScope key for qwen3-asr-flash
DEMO_SPEECH_KEY=
